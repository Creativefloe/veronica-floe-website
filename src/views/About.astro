---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';
import { resolveImage } from '../lib/images';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = t(lang);
const aboutImage = resolveImage(site.aboutImage);
---
<BaseLayout lang={lang} page="about">
  <section class="container about">
    <div class="photo portrait">
      {aboutImage && <Picture
        src={aboutImage}
        alt={c.about.imageAlt}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 900px) 42vw, 100vw"
        formats={['webp']}
        loading="eager"
      />}
    </div>

    <div class="text">
      <h1>{c.about.heading}</h1>
      <p class="intro">{c.about.lead}</p>
      {c.about.story.map((p) => <p>{p}</p>)}

      <h2 class="reveal">{c.about.styleHeading}</h2>
      <div class="reveal">
        {c.about.style.map((p, i) => <p class:list={{ 'pull': i === 0 }}>{p}</p>)}
      </div>

      <div class="personal reveal">
        <h2>{c.about.personalHeading}</h2>
        <ul>
          {c.about.personal.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} heading={c.about.cta.heading} text={c.about.cta.text} />
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 6vw, 6.5rem);
    align-items: start;
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) var(--section);
  }
  .portrait {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    aspect-ratio: 4 / 5;
  }
  .text { max-width: var(--max-text); }
  .intro {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    line-height: 1.3;
    color: var(--color-ink);
    margin-bottom: 1.5em;
  }
  h2 { font-size: var(--text-h3); margin-top: 2.5em; }
  .pull { font-size: var(--text-lg); color: var(--color-ink); }

  .personal {
    margin-top: 3rem;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    background: var(--color-surface);
  }
  .personal h2 { margin-top: 0; }
  .personal ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.85rem; }
  .personal li { position: relative; padding-left: 1.6rem; }
  .personal li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 0.75rem;
    height: 1px;
    background: var(--color-accent);
  }

  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; }
    .portrait { position: static; aspect-ratio: 4 / 4.4; }
  }
</style>
