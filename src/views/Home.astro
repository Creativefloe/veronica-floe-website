---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import hero from '../content/hero.json';
import { resolveImage } from '../lib/images';
import { site } from '../config/site';
import { t, url, formatPrice, type Lang } from '../i18n';
import { getPhotos, firstOf } from '../lib/portfolio';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = t(lang);

const sessionKeys = ['couples', 'pregnancy', 'family'] as const;
const sessions = sessionKeys.map((key) => ({
  key,
  ...c.sessions[key],
  price: formatPrice(lang, site.prices[key]),
  photo: firstOf(lang, key),
}));

// Slideshow photos are managed in the CMS (Home slideshow) -> src/content/hero.json
const slides = (hero.slides as { image: string; position?: string; alt?: { no?: string; en?: string } }[])
  .map((s) => ({ ...s, src: resolveImage(s.image) }))
  .filter((s) => s.src);
const aboutImage = resolveImage(site.aboutImage);

const featured = getPhotos(lang).filter((p) => p.featured).slice(0, 6);
const testimonials = c.home.testimonials.items;
---
<BaseLayout lang={lang} page="home">
  <section class="hero">
    <div class="hero-media" data-hero-slides>
      {slides.map((s, i) => (
        <Picture
          src={s.src!}
          alt={s.alt?.[lang] ?? ''}
          class="hero-img"
          pictureAttributes={{ class: `hero-slide${i === 0 ? ' is-active' : ''}`, 'aria-hidden': i === 0 ? undefined : 'true' }}
          style={s.position ? `object-position: ${s.position}` : undefined}
          widths={[640, 960, 1280, 1920, 2400]}
          sizes="100vw"
          formats={['webp']}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
        />
      ))}
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-content">
      <p class="eyebrow hero-eyebrow">{c.home.hero.eyebrow}</p>
      <h1>Creative <em>Flø</em></h1>
      <p class="hero-tagline">{c.home.hero.tagline}</p>
      <div class="hero-ctas" data-hide-mobile-book>
        <a class="btn btn--light" href={url('contact', lang)}>{c.common.bookCta}</a>
        <a class="hero-link" href={url('portfolio', lang)}>{c.common.seePortfolio}<Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
    {slides.length > 1 && (
      <button
        type="button"
        class="hero-toggle"
        hidden
        data-hero-toggle
        data-pause={c.home.hero.pause}
        data-play={c.home.hero.play}
        aria-label={c.home.hero.pause}
      >
        <span class="hero-toggle-icon" data-icon="pause" aria-hidden="true"></span>
      </button>
    )}
  </section>

  <section class="section intro">
    <div class="container narrow reveal">
      <h2>{c.home.intro.heading}</h2>
      <p class="lead">{c.home.intro.text}</p>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="sessions-heading">
    <div class="container">
      <h2 id="sessions-heading" class="reveal">{c.home.sessionsHeading}</h2>
      <div class="sessions">
        {sessions.map((s, i) => (
          <article class:list={['session', `session--${i + 1}`, 'reveal']}>
            {s.photo && (
              <div class="photo session-photo">
                <Picture
                  src={s.photo.src}
                  alt=""
                  widths={[480, 720, 960, 1280]}
                  sizes={i === 0 ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 100vw'}
                  formats={['webp']}
                />
              </div>
            )}
            <div class="session-body">
              <h3>{s.name}</h3>
              <p>{s.short}</p>
              <p class="price">{c.common.from} {s.price}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="sessions-more reveal">
        <a class="text-link" href={url('services', lang)}>{c.home.sessionsLink}<Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <div class="container">
      <h2 id="work-heading" class="reveal">{c.home.work.heading}</h2>
      <ul class="work" role="list">
        {featured.map((p, i) => (
          <li class:list={['photo', 'work-item', 'reveal']}>
            <Picture
              src={p.src}
              alt={p.alt}
              widths={[400, 640, 960]}
              sizes="(min-width: 900px) 33vw, 50vw"
              formats={['webp']}
            />
          </li>
        ))}
      </ul>
      <p class="reveal">
        <a class="text-link" href={url('portfolio', lang)}>{c.home.work.cta}<Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>

  <section class="section section--soft about">
    <div class="container about-grid">
      <div class="photo about-photo reveal">
        {aboutImage && <Picture src={aboutImage} alt={c.home.aboutTeaser.imageAlt} widths={[480, 720, 960]} sizes="(min-width: 900px) 40vw, 100vw" formats={['webp']} />}
      </div>
      <div class="about-text reveal">
        <h2>{c.home.aboutTeaser.heading}</h2>
        <p class="lead">{c.home.aboutTeaser.text}</p>
        <a class="text-link" href={url('about', lang)}>{c.home.aboutTeaser.cta}<Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="section testimonials" aria-labelledby="testimonials-heading">
      <div class="container">
        <h2 id="testimonials-heading" class="reveal">{c.home.testimonials.heading}</h2>
        <div class="quotes">
          {testimonials.map((q) => (
            <figure class="quote reveal">
              <blockquote><p>{q.quote}</p></blockquote>
              <figcaption>{q.name}{q.session && <span>, {q.session}</span>}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand lang={lang} heading={c.home.finalCta.heading} text={c.home.finalCta.text} />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: min(88svh, 60rem);
    display: flex;
    align-items: flex-end;
    color: var(--color-on-ink);
    overflow: hidden;
    background: var(--color-surface-strong);
  }
  .hero-media { position: absolute; inset: 0; }
  .hero :global(.hero-slide) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.6s var(--ease);
  }
  .hero :global(.hero-slide.is-active) { opacity: 1; }
  .hero :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero :global(.hero-slide) { transition: none; }
  }

  .hero-toggle {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(247 243 236 / 0.5);
    border-radius: var(--radius-pill);
    background: rgb(33 30 27 / 0.25);
    color: var(--color-on-ink);
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }
  .hero-toggle:hover { background: rgb(33 30 27 / 0.5); }
  .hero-toggle:focus-visible { outline-color: var(--color-on-ink); }
  /* Pause = two bars, play = triangle (pure CSS, no icon font needed) */
  .hero-toggle-icon[data-icon='pause'] {
    width: 10px; height: 12px;
    border-left: 3px solid currentColor;
    border-right: 3px solid currentColor;
  }
  .hero-toggle-icon[data-icon='play'] {
    width: 0; height: 0;
    margin-left: 3px;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 10px solid currentColor;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(33 30 27 / 0.62) 0%, rgb(33 30 27 / 0.18) 50%, rgb(33 30 27 / 0) 75%);
  }
  @media (min-width: 900px) {
    /* Darker on the left where the text sits, so the couple in the middle stays clear */
    .hero-shade {
      background:
        linear-gradient(to right, rgb(33 30 27 / 0.55) 0%, rgb(33 30 27 / 0.2) 32%, rgb(33 30 27 / 0) 48%),
        linear-gradient(to top, rgb(33 30 27 / 0.5) 0%, rgb(33 30 27 / 0) 45%);
    }
  }
  .hero-content {
    position: relative;
    padding-block: clamp(3rem, 2rem + 6vw, 6rem);
  }
  .hero-eyebrow { color: rgb(247 243 236 / 0.85); }
  .hero h1 {
    color: var(--color-on-ink);
    font-size: clamp(3.4rem, 2rem + 5vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-bottom: 0.25em;
    padding-bottom: 0.05em;
  }
  .hero h1 em { font-style: italic; }
  .hero-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.75rem);
    line-height: 1.35;
    max-width: 24rem;
    margin-bottom: 2rem;
  }
  .hero-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    color: var(--color-on-ink);
    font-weight: 500;
    letter-spacing: 0.04em;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .hero-link:hover { color: var(--color-on-ink); text-decoration: underline; }

  /* Intro */
  .narrow { max-width: 46rem; text-align: center; }
  .intro .lead { margin-inline: auto; max-width: 42rem; }

  /* Sessions: one large feature with two smaller, offset items */
  .sessions {
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
    margin-top: 2.5rem;
  }
  .session-photo { display: block; aspect-ratio: 4 / 5; margin-bottom: 1.25rem; }
  .session-photo :global(img) { transition: transform 1.2s var(--ease); }
  .session:hover .session-photo :global(img) { transform: scale(1.03); }
  .session--2 { margin-top: clamp(2rem, 8vw, 7rem); }
  .session--3 { margin-top: clamp(1rem, 4vw, 3.5rem); }
  .session h3 { margin-bottom: 0.3em; }
  .session-body p { color: var(--color-body); }
  .price {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-ink);
  }
  .sessions-more { margin-top: 3rem; }

  /* Selected work: staggered masonry */
  .work {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 2.5rem;
    columns: 3;
    column-gap: clamp(0.75rem, 2vw, 1.5rem);
  }
  .work-item {
    break-inside: avoid;
    margin-bottom: clamp(0.75rem, 2vw, 1.5rem);
  }

  /* About teaser */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .about-photo { aspect-ratio: 4 / 5; max-width: 30rem; }
  .about-text .lead { margin-bottom: 2rem; }

  /* Testimonials */
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 3rem;
    margin-top: 2rem;
  }
  .quote { margin: 0; }
  .quote blockquote { margin: 0 0 1rem; }
  .quote blockquote p {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.4;
    color: var(--color-ink);
  }
  .quote figcaption { color: var(--color-muted); font-size: var(--text-sm); letter-spacing: 0.04em; }

  @media (max-width: 900px) {
    .sessions { grid-template-columns: 1fr 1fr; }
    .session--1 { grid-column: 1 / -1; }
    .session--1 .session-photo { aspect-ratio: 3 / 2; }
    .session--2 { margin-top: 0; }
    .session--3 { margin-top: 3rem; }
    .work { columns: 2; }
    .about-grid { grid-template-columns: 1fr; }
    .about-photo { max-width: none; aspect-ratio: 4 / 3; }
  }
  @media (max-width: 600px) {
    .sessions { grid-template-columns: 1fr; gap: 3rem; }
    .session--3 { margin-top: 0; }
    .session--1 .session-photo, .session-photo { aspect-ratio: 4 / 5; }
  }

  /* Phones: photo on top, text below on the page background, so the photo stays uncovered */
  @media (max-width: 700px) {
    .hero {
      display: block;
      min-height: 0;
      color: var(--color-ink);
      background: var(--color-canvas);
    }
    .hero-media {
      position: relative;
      inset: auto;
      aspect-ratio: 4 / 4.6;
    }
    .hero-toggle { top: calc(min(100vw, 700px) * 1.15 - 3.5rem); bottom: auto; right: 1rem; }
    .hero-shade { display: none; }
    .hero-content { padding-block: 2rem 2.5rem; }
    .hero-eyebrow { color: var(--color-muted); }
    .hero h1 { color: var(--color-ink); }
    .hero-tagline { color: var(--color-body); }
    .hero :global(.btn--light) {
      background: var(--color-ink);
      border-color: var(--color-ink);
      color: var(--color-on-ink);
    }
    .hero-link, .hero-link:hover { color: var(--color-ink); }
  }
</style>

<script>
  // Home slideshow: soft crossfade every 6 seconds.
  // Stays on the first photo when the visitor prefers reduced motion; pauses when the tab is hidden.
  const wrap = document.querySelector<HTMLElement>('[data-hero-slides]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  const slides = wrap ? [...wrap.querySelectorAll<HTMLElement>('.hero-slide')] : [];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (slides.length > 1 && toggle && !reduce) {
    const INTERVAL = 6000;
    let index = 0;
    let timer: number | undefined;
    let paused = false;

    // Start loading the other photos once the page has settled
    addEventListener('load', () => {
      slides.forEach((s) => s.querySelector('img')?.setAttribute('loading', 'eager'));
    });

    const show = (next: number) => {
      slides[index].classList.remove('is-active');
      slides[index].setAttribute('aria-hidden', 'true');
      index = (next + slides.length) % slides.length;
      slides[index].classList.add('is-active');
      slides[index].removeAttribute('aria-hidden');
    };
    const start = () => {
      stop();
      if (!paused) timer = window.setInterval(() => show(index + 1), INTERVAL);
    };
    const stop = () => window.clearInterval(timer);

    const icon = toggle.querySelector<HTMLElement>('[data-icon]')!;
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.setAttribute('aria-label', (paused ? toggle.dataset.play : toggle.dataset.pause) ?? '');
      icon.dataset.icon = paused ? 'play' : 'pause';
      paused ? stop() : start();
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  }
</script>
