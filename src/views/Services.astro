---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { t, url, formatPrice, termsAnchor, type Lang } from '../i18n';
import { firstOf } from '../lib/portfolio';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = t(lang);
const s = c.services;

const sessions = (['couples', 'pregnancy', 'family'] as const).map((key) => ({
  key,
  ...c.sessions[key],
  price: formatPrice(lang, site.prices[key]),
  photo: firstOf(lang, key),
}));

const offers = sessions.map((x) => ({
  '@type': 'Offer',
  name: x.name,
  priceCurrency: 'NOK',
  priceSpecification: { '@type': 'PriceSpecification', minPrice: site.prices[x.key], priceCurrency: 'NOK' },
}));
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: s.heading,
  itemListElement: offers,
}];
---
<BaseLayout lang={lang} page="services" jsonLd={jsonLd}>
  <section class="container page-head">
    <h1>{s.heading}</h1>
    <p class="lead">{s.intro}</p>
  </section>

  <section class="container sessions" aria-label={c.home.sessionsHeading}>
    {sessions.map((x, i) => (
      <article class:list={['session', 'reveal', { flip: i % 2 === 1 }]} id={x.key}>
        {x.photo && (
          <div class="photo session-photo">
            <Picture src={x.photo.src} alt="" widths={[480, 720, 960]} sizes="(min-width: 900px) 38vw, 100vw" formats={['webp']} />
          </div>
        )}
        <div class="session-body">
          <h2>{x.name}</h2>
          <p class="price">{c.common.from} <strong>{x.price}</strong></p>
          <p>{x.long}</p>
        </div>
      </article>
    ))}
    <p class="price-note">{s.priceNote}</p>
  </section>

  <section class="section section--soft">
    <div class="container other reveal">
      <h2>{s.other.heading}</h2>
      <p class="lead">{s.other.text}</p>
      <a class="btn btn--ghost" href={url('contact', lang)}>{c.common.quoteCta}</a>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div class="reveal">
        <h2>{s.included.heading}</h2>
        <ul class="included">
          {s.included.items.map((item) => <li>{item}</li>)}
        </ul>
        <p class="muted">{s.included.note}</p>
      </div>
      <div class="side reveal">
        <h2>{s.delivery.heading}</h2>
        <dl class="timeline">
          {s.delivery.items.map((d) => (
            <div>
              <dt>{d.when}</dt>
              <dd>{d.what}</dd>
            </div>
          ))}
        </dl>
        <p class="muted">{s.delivery.note}</p>

        <h2 class="travel-h">{s.travel.heading}</h2>
        <p>{s.travel.text}</p>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <h2 class="reveal">{s.booking.heading}</h2>
      <ol class="steps">
        {s.booking.steps.map((step) => (
          <li class="reveal">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section terms" id={termsAnchor[lang]}>
    <div class="container narrow">
      <h2>{s.terms.heading}</h2>
      <p class="lead">{s.terms.intro}</p>
      <h3>{s.terms.cancelHeading}</h3>
      <dl class="rules">
        {s.terms.rules.map((r) => (
          <div>
            <dt>{r.when}</dt>
            <dd>{r.what}</dd>
          </div>
        ))}
      </dl>
      <p class="muted">{s.terms.note}</p>
      <p><a class="text-link" href={url('faq', lang)}>{c.nav.faq}<Icon name="arrow-right" /></a></p>
    </div>
  </section>

  <CtaBand lang={lang} heading={s.cta.heading} text={s.cta.text} />
</BaseLayout>

<style>
  .sessions { display: grid; gap: clamp(3.5rem, 8vw, 7rem); padding-bottom: var(--section); }
  .session {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(1.75rem, 5vw, 5rem);
    align-items: center;
  }
  .session.flip .session-photo { order: 2; }
  .session-photo { aspect-ratio: 4 / 5; }
  .session-body { max-width: 32rem; }
  .price {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }
  .price strong { color: var(--color-ink); font-weight: 500; }
  .price-note { color: var(--color-muted); font-size: var(--text-sm); margin: 0; }

  .other { max-width: 46rem; }
  .other .lead { margin-bottom: 2rem; }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 7rem);
  }
  .included { list-style: none; margin: 1.5rem 0; padding: 0; display: grid; gap: 1rem; }
  .included li { position: relative; padding-left: 2rem; color: var(--color-ink); }
  .included li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.55em;
    width: 0.55rem;
    height: 0.3rem;
    border-left: 1.5px solid var(--color-accent);
    border-bottom: 1.5px solid var(--color-accent);
    transform: rotate(-45deg);
  }
  .muted { color: var(--color-muted); font-size: var(--text-sm); }

  .timeline { margin: 1.5rem 0; display: grid; gap: 1.25rem; }
  .timeline div { padding-left: 1.25rem; border-left: 1px solid var(--color-accent); }
  .timeline dt { font-family: var(--font-display); font-size: 1.4rem; color: var(--color-ink); line-height: 1.2; }
  .timeline dd { margin: 0.2rem 0 0; }
  .travel-h { margin-top: 2.5rem; }

  .steps {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    counter-reset: step;
  }
  .steps li { counter-increment: step; }
  .steps li::before {
    content: counter(step);
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }
  .steps h3 { font-size: 1.5rem; }

  .narrow { max-width: 46rem; }
  .terms h3 { font-size: 1.6rem; margin-top: 2rem; }
  .rules { margin: 1.25rem 0 1.5rem; }
  .rules div { padding-block: 1.1rem; border-bottom: 1px solid var(--color-hairline); }
  .rules div:first-child { border-top: 1px solid var(--color-hairline); }
  .rules dt { font-weight: 500; color: var(--color-ink); }
  .rules dd { margin: 0.25rem 0 0; }

  @media (max-width: 900px) {
    .session, .two-col { grid-template-columns: 1fr; }
    .session.flip .session-photo { order: 0; }
    .session-photo { aspect-ratio: 4 / 3.6; }
    .steps { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
