# Copy this file to ".env" for local development, and add the same variables in Netlify / Cloudflare Pages.

# Your real domain (used for canonical URLs, sitemap, hreflang and social previews)
SITE_URL=https://creativefloe.com

# Contact form endpoint from Formspree, e.g. https://formspree.io/f/abcdwxyz
# Leave empty and the form shows an email link instead of sending.
PUBLIC_FORM_ENDPOINT=
